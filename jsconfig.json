{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "#argv2Object": ["./src/argv2Object.mjs"],
      "#constants": ["./src/constants.mjs"],
      "#functions": ["./src/functions.mjs"]
    }
  },
  "include": ["source/**/*"],
  "exclude": ["**/node_modules", "**/dist", "**/coverage", "**/.turbo", "**/.next"]
}
